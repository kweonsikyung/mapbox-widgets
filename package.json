{
  "name": "@kweonsikyung/mapbox-gl-kit",
  "version": "0.1.0",
  "description": "Composable Mapbox GL JS widgets for ship route visualization",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "mapbox-gl": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "mapbox-gl": "^3.15.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "storybook": "^10.5.5",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.2.0"
  },
  "keywords": [
    "mapbox",
    "mapbox-gl",
    "gis",
    "map",
    "route",
    "ship",
    "vessel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kweonsikyung/mapbox-widgets.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
